# Optional settings. To use them, copy this file to a file named ".env"
# (in the same folder) and change the values. Lines starting with # are ignored.
# You do NOT need any of this to try the site on your own computer.

# The name shown at the top of every page.
SITE_NAME=Inkwell

# The port the site runs on (http://localhost:3000).
PORT=3000

# Only accept connections from this computer itself. Use 127.0.0.1 on a server
# where Apache sits in front of the site.
# HOST=127.0.0.1

# Where the database and uploaded pictures are kept (default: the data folder).
# DATA_DIR=/var/lib/inkwell/data

# The public address of the site. Used in password reset emails.
# When you put the site online, set this to your real address, e.g. https://myblog.com
BASE_URL=http://localhost:3000

# Set to 1 when the site runs behind a proxy / hosting platform (most online hosts).
# TRUST_PROXY=1

# Email sending, for "forgot password" emails. Without these, the email
# (with the reset link) is printed in the terminal window instead.
# Your email provider (e.g. Mailgun, Postmark, SendGrid, Gmail) gives you these values.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-username
# SMTP_PASS=your-password
# MAIL_FROM=Inkwell <no-reply@myblog.com>

<% const s = [22, 28, 32, 40, 56, 88, 96].includes(typeof size !== 'undefined' ? size : 40) ? (typeof size !== 'undefined' ? size : 40) : 40; %>
<% if (user && user.avatar) { %><img class="avatar avatar-<%= s %>" src="<%= user.avatar %>" alt="" width="<%= s %>" height="<%= s %>"><% } else { %><span class="avatar avatar-initials avatar-<%= s %>" aria-hidden="true"><%= ((user && user.name) || '?').trim().charAt(0).toUpperCase() %></span><% } %>

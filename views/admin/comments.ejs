<%- include('../partials/header') %>
<h1>Admin: comments</h1>
<%- include('_nav') %>
<% const backUrl = '/admin/comments' + (Object.keys(query).length ? '?' + new URLSearchParams(Object.entries(query).filter(([, v]) => typeof v === 'string')).toString() : ''); %>
<div class="table-wrap">
<table class="table">
  <thead><tr><th>Comment</th><th>By</th><th>On post</th><th>Date</th><th></th></tr></thead>
  <tbody>
  <% comments.forEach((c) => { %>
    <tr>
      <td class="comment-cell"><div class="comment-body"><%- c.content_html %></div></td>
      <td><a href="/u/<%= c.user_id %>"><%= c.user_name %></a></td>
      <td><a href="/posts/<%= c.post_id %>#comment-<%= c.id %>"><%= c.post_title %></a></td>
      <td class="muted small"><%= h.formatDate(c.created_at) %></td>
      <td class="row-actions"><%- include('_action', { action: `/admin/comments/${c.id}/delete`, label: 'Delete', backUrl, danger: true, confirm: 'Delete this comment?' }) %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% if (!comments.length) { %><p class="empty">No comments found.</p><% } %>
<%- include('../partials/pager') %>
<%- include('../partials/footer') %>

<%- include('../partials/header') %>
<div class="formbox">
  <h1>Welcome back</h1>
  <%- include('../partials/error-box') %>
  <form method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="next" value="<%= next %>">
    <label>Email <input type="email" name="email" value="<%= values.email || '' %>" required autocomplete="email" autofocus></label>
    <label>Password <input type="password" name="password" required autocomplete="current-password"></label>
    <button class="btn btn-block" type="submit">Log in</button>
  </form>
  <p class="center"><a href="/forgot-password">Forgot your password?</a></p>
  <p class="muted center">New here? <a href="/signup">Create an account</a></p>
</div>
<%- include('../partials/footer') %>
